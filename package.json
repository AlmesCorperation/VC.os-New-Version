    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "libarchive": "^0.0.1-develop.15",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-draggable": "^4.5.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.169.0",
    "vite": "^6.2.0",
    "ws": "^8.19.0",
